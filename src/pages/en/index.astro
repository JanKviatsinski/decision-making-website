---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { SITE_BASE, SocialLinks } from '../../consts'
import { Icon } from 'astro-icon/components'
// import BlogCard from '../../components/BlogCard.astro'
// import { getCollection } from 'astro:content'
import TwoColumns from '@/components/TwoColumns.astro'
import { Image } from 'astro:assets'

// const posts = (await getCollection('blog'))
// 	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
// 	.slice(0, 4)

const images = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/**/*.{jpeg,jpg,png,gif,webp}'
)

const peopleOnTheTrainImage = '/src/assets/people talking on the train.webp'
const walkingInAGardenImage = '/src/assets/walking_in_a_garden.webp'
---

<BaseLayout>
	<main
		class="app-container flex flex-col gap-12 justify-center py-24 md:py-32 pt-44 md:pt-56 relative"
	>
		<div>
			<p class="block text-3xl opacity-70 mt-9 mb-4">Welcome to</p>
			<h1 class="text-6xl font-bold leading-none">Decision Garden</h1>
		</div>
		<p class="text-2xl max-w-2xl font-light leading-normal">
			The place where you will make decisions.
		</p>
		<!-- <div class="flex flex-wrap gap-8">
			{
				SocialLinks.map((link) => (
					<a
						class="text-xl text-primary dark:text-primary-dark underline hover:underline underline-offset-4"
						href={link.url}
						target="_blank"
					>
						{link.name}
					</a>
				))
			}
		</div> -->
	</main>

	<!-- Recent Posts Section -->
	<!-- <section class="app-container">
		<h2 class="section-title">Recent Posts</h2>
		<div class="posts-grid-container">
			{posts.map((post) => <BlogCard post={post} />)}
		</div>
		<a class="btn-secondary" href="/blog"
			>Read All
			<Icon size={20} name="mdi:arrow-right" />
		</a>
	</section> -->

	<TwoColumns>
		<div slot="left" class="md:order-2">
			<h2 class="section-title">
				Let’s talk like old friends walking through a garden.
			</h2>
			<p class="text-2xl">
				I want this website and our meetings to feel like a peaceful, beautiful
				garden—a place where you can share your thoughts with someone you truly
				trust.
			</p>
			<a class="btn-primary ml-auto" href="" target="_blank"
				>Get in touch
				<Icon height={20} name="mdi:calendar" />
			</a>
		</div>

		<div slot="right">
			<Image
				src={images[walkingInAGardenImage]()}
				alt={'people talking on the train'}
				class="object-cover rounded-xl aspect-video"
			/>
		</div>
	</TwoColumns>

	<TwoColumns>
		<div slot="left" class="">
			<h2 class="section-title">
				Or we can discuss your problem like strangers.
			</h2>
			<p class="text-2xl">
				Sometimes, just telling someone about your struggles can help you find a
				way to resolve them. You can discuss it with me. Imagine that I’m just a
				stranger you met on a train during a long trip. Let’s talk. We will
				newer meet again after the end of the trip.
			</p>
			<a class="btn-primary" href="" target="_blank"
				>Get in touch
				<Icon height={20} name="mdi:calendar" />
			</a>
		</div>

		<div slot="right">
			<Image
				src={images[peopleOnTheTrainImage]()}
				alt={'people talking on the train'}
				class="object-cover rounded-xl aspect-video"
			/>
		</div>
	</TwoColumns>

	<section class="md:text-right app-container">
		<h2 class="section-title">Human support shouldn't cost a fortune.</h2>
		<p class="text-2xl md:max-w-3xl text-justify md:ml-auto">
			I am simply one human helping another. You don't need to pay the high
			rates of a professional coach or psychologist. I believe in a "pay what
			you can" model—after each meeting, you decide on an amount that feels
			right to you as a thank you.
		</p>
		<div class="flex justify-end text-justify">
			<a class="btn-secondary" href="#payment"
				>About payment <Icon height={20} name="mdi:hand-coin" /></a
			>

			<!-- <a class="btn-primary" href="" target="_blank"
				>Get in touch
				<Icon height={20} name="mdi:calendar" />
			</a> -->
		</div>
	</section>

	<section class="app-container py-20">
		<h2 class="section-title" id="payment">
			A simple, human way to give back.
		</h2>
		<p class="text-2xl md:max-w-3xl text-justify">
			After we talk, you decide the value of the help you received. It’s an
			unconventional approach, but I believe in the kindness and integrity of
			others.
			<br />
			<br />
			Bank account: 11111213123123
			<br />
			<br />
			BitCoin wallet: some wallet number.
			<br />
			<br />
			<p class="font-bold text-2xl">Thank you so mutch!</p>
		</p>
	</section>

	<!-- Recent Posts Section -->
	<!-- TODO replace section by TwoColumns -->
	<section class="app-container py-20 grid lg:grid-cols-2 gap-28 lg:gap-10">
		<div class="space-y-6">
			<h2 class="section-title">About Me</h2>
			<p class="text-lg max-w-xl pb-4">
				A brief introduction about yourself. You can include your profession,
				hobbies, interests, or anything you'd like visitors to know about you.
			</p>
			<a class="btn-secondary" href={`${SITE_BASE}/about`}
				>Go to About
				<Icon size={20} name="mdi:arrow-right" />
			</a>
		</div>
		<div class="space-y-6">
			<h2 class="section-title">Get in touch</h2>
			<p class="text-lg max-w-xl">
				Use the buttons below for my resume & email.
			</p>

			<a
				class="btn-primary"
				href="mailto:example@email.com"
				download
				target="_blank"
				>Get in touch
				<Icon height={20} name="mdi:email" />
			</a>
		</div>
	</section>
</BaseLayout>
